interface io.github.hepp3n.kdeconnect

type Device (
    id: string,
    name: string,
    device_type: string,
    is_paired: bool,
    is_reachable: bool
)

type BatteryState (
    level: int,
    is_charging: bool
)

method ListDevices() -> (devices: []Device)
method PairDevice(device_id: string) -> ()
method UnpairDevice(device_id: string) -> ()
method SendPing(device_id: string, message: string) -> ()
method SendFiles(device_id: string, files: []string) -> ()
method SendClipboard(device_id: string, content: string) -> ()
method ShareClipboard(device_id: string) -> ()
method RunCommand(device_id: string, key: string) -> ()
method RingDevice(device_id: string) -> ()
method BrowseDevice(device_id: string) -> ()
method UnmountDevice(device_id: string) -> ()
method MountedDevices() -> (device_ids: []string)
method BroadcastIdentity() -> ()
method RequestRunCommands(device_id: string) -> ()
method SetPluginEnabled(device_id: string, plugin: string, enabled: bool) -> ()
method GetPluginEnabled(device_id: string, plugin: string) -> (enabled: bool)
method GetDisabledPlugins(device_id: string) -> (plugins: []string)
method AcceptPairing(device_id: string) -> ()
method RejectPairing(device_id: string) -> ()

method RequestConversations(device_id: string) -> ()
method RequestConversation(device_id: string, thread_id: int) -> ()
method SendSms(device_id: string, phone_number: string, message: string, attachments: []string) -> ()
method GetCachedSms(device_id: string) -> (json: string)
method RequestContacts(device_id: string) -> ()
method GetCachedContacts(device_id: string) -> (json: string)
method GetCachedContactPhotos(device_id: string) -> (json: string)
method RequestSmsAttachment(device_id: string, part_id: int, unique_identifier: string) -> ()
method GetRecentTransfers(device_id: string) -> (json: string)

method Subscribe() -> (
    event_type: string,
    device_id: string,
    device: ?Device,
    battery: ?BatteryState,
    connectivity_strength: ?int,
    clipboard_content: ?string,
    commands_json: ?string,
    message: ?string
)

error DeviceNotFound(device_id: string)
error NotPaired(device_id: string)
error ServiceError(reason: string)
